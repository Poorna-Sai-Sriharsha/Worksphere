rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Match any document in the 'tasks' sub-collection under a specific user
    match /users/{userId}/tasks/{taskId} {

      // ONLY allow access if the user is authenticated AND
      // their authenticated UID matches the userId in the URL path.
      allow read, write: if request.auth != null && request.auth.uid == userId;

    }

    // Optional: If you later add a 'profiles' collection for user info
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
